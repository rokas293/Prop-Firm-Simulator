{
  "name": "propbt-viz",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "concurrently -n backend,frontend -c blue,green \"npm:dev:backend\" \"npm:dev:frontend\"",
    "dev:backend": "python -m uvicorn app.backend.main:app --reload --port 8000",
    "dev:frontend": "npm --prefix app/frontend run dev"
  },
  "devDependencies": {
    "concurrently": "^9.0.1"
  }
}
